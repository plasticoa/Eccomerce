# Requeridas en todos los entornos. La clave publishable es preferida;
# NEXT_PUBLIC_SUPABASE_ANON_KEY existe solo como alternativa compatible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto exclusivo del servidor. Solo para funciones que administren Auth; no se necesita para pagos manuales.
SUPABASE_SERVICE_ROLE_KEY=

# Origen completo del entorno, sin ruta: https://tienda.example
NEXT_PUBLIC_SITE_URL=
