# Requeridas en todos los entornos. La clave publishable es preferida;
# NEXT_PUBLIC_SUPABASE_ANON_KEY existe solo como alternativa compatible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto exclusivo del servidor. Requerido por administración de Auth y webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Origen completo del entorno, sin ruta: https://tienda.example
NEXT_PUBLIC_SITE_URL=

# El adaptador "test" solo funciona fuera de producción. El proveedor real
# permanece pendiente y debe implementar el contrato PaymentProvider.
PAYMENT_PROVIDER=
PAYMENT_TEST_WEBHOOK_SECRET=
PAYMENT_TEST_MODE_ENABLED=
